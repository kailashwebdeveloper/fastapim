[Unit]
Description=FastAPI Application
After=network.target

[Service]
User=ubuntu
Group=ubuntu

WorkingDirectory=/var/lib/jenkins/workspace/test2

Environment="PATH=/var/lib/jenkins/workspace/test2/venv/bin"

ExecStart=/var/lib/jenkins/workspace/test2/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
